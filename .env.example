# Copia este archivo como .env y cambia los valores.
# Genera una SECRET_KEY con:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=cambia-esta-clave-por-una-aleatoria
DB_HOST=localhost
DB_PORT=3306
DB_USER=sate_app
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=techtrack_sate
DB_CHARSET=utf8mb4

# 1 solo para desarrollo local. En producción debe ser 0.
FLASK_DEBUG=0

# 1 solo si sirves la app por HTTPS.
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_HOURS=8
MAX_CONTENT_LENGTH_MB=16
APP_NAME=TechTrack Solutions
